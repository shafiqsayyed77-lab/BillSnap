# ==============================================================================
# BillSnap Server Environment Variables Example
# Duplicate this file as .env and fill in the values below.
# ==============================================================================

# Port the Express server listens on (default: 5000)
PORT=5000

# MongoDB Connection String:
# Can be a local MongoDB (mongodb://localhost:27017/billsnap) or MongoDB Atlas URL.
# If left blank or connection fails, an automatic in-memory MongoDB will be used.
MONGO_URI=mongodb://localhost:27017/billsnap

# JSON Web Token secret key for signing auth tokens (use a long, random string in production)
JWT_SECRET=billsnap_super_secret_jwt_key_2026_change_in_production

# JWT Expiration time (e.g., 7d = 7 days, 24h = 24 hours)
JWT_EXPIRES_IN=7d

# Allowed frontend URL for CORS (Cross-Origin Resource Sharing)
CLIENT_URL=http://localhost:5173

# Smart Search query parsing mode:
# Set to 'false' to use the fast deterministic rule-based natural language parser.
# Set to 'true' if connecting an LLM provider (OpenAI, Gemini, etc.).
USE_LLM_PARSER=false
